/* Home dot at end of timeline */
.timeline-home-dot {
  position: relative;
  height: 20px;
  margin-top: -10px;
}

.timeline-home-dot a {
  display: block;
  position: absolute;
  left: -9px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--bs-danger);
  z-index: 2;
  cursor: pointer;
  transition: transform 0.2s, opacity 0.2s;
}

.timeline-home-dot a:hover {
  opacity: 0.75;
  transform: scale(1.25);
}

@media (min-width: 768px) {
  .timeline-home-dot a {
    left: calc(50% - 9px);
  }
}
